7<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#183b32">
  <title>رَواق | قهوتك على مهل</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Alexandria:wght@400;500;600;700;800&display=swap');

    :root {
      --green: #183b32;
      --green-light: #315c4c;
      --cream: #f7f4ec;
      --orange: #db8a55;
      --ink: #202820;
      --muted: #777c73;
      --white: #fff;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: "Alexandria", sans-serif;
      color: var(--ink);
      background: var(--cream);
      line-height: 1.8;
    }
    a { color: inherit; text-decoration: none; }
    button, input, select, textarea { font: inherit; }
    button { cursor: pointer; }
    .container { width: min(1120px, 90%); margin-inline: auto; }

    header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: rgba(247,244,236,.94);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(24,59,50,.08);
    }
    .nav {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .logo { color: var(--green); font-size: 1.6rem; font-weight: 800; }
    .logo span { color: var(--orange); }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-links a { font-size: .9rem; color: #4e554f; }
    .nav-links a:hover { color: var(--orange); }
    .cart-button, .button {
      border: 0;
      border-radius: 999px;
      padding: 11px 19px;
      background: var(--green);
      color: var(--white);
      transition: .2s;
    }
    .cart-button:hover, .button:hover { background: var(--green-light); transform: translateY(-2px); }
    .cart-count {
      display: inline-grid;
      place-items: center;
      width: 22px;
      height: 22px;
      margin-right: 5px;
      border-radius: 50%;
      background: var(--orange);
      color: white;
      font-size: .75rem;
    }

    .hero {
      min-height: 590px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 36px;
      padding-block: 60px;
    }
    .eyebrow { color: var(--orange); font-weight: 700; font-size: .9rem; }
    h1 {
      margin: 13px 0 18px;
      color: var(--green);
      font-size: clamp(2.5rem, 5vw, 4.7rem);
      line-height: 1.3;
    }
    .hero p { max-width: 520px; color: var(--muted); margin-bottom: 25px; }
    .hero-image {
      min-height: 410px;
      border-radius: 180px 180px 28px 28px;
      background:
        linear-gradient(0deg, rgba(12,32,26,.12), transparent 55%),
        url("https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=1100&q=85") center/cover;
      box-shadow: 0 25px 60px rgba(24,59,50,.15);
    }
    .button.secondary { background: transparent; color: var(--green); border: 1px solid var(--green); margin-right: 8px; }

    section { padding-block: 76px; }
    .section-heading { text-align: center; margin-bottom: 36px; }
    .section-heading h2 { color: var(--green); font-size: clamp(1.8rem, 3vw, 2.5rem); }
    .section-heading p { color: var(--muted); margin-top: 8px; }

    .menu-section { background: #fffdf8; }
    .products {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }
    .product {
      overflow: hidden;
      border-radius: 18px;
      background: white;
      box-shadow: 0 8px 28px rgba(32,40,32,.06);
      transition: transform .2s;
    }
    .product:hover { transform: translateY(-5px); }
    .product img { display: block; width: 100%; height: 210px; object-fit: cover; }
    .product-content { padding: 18px; }
    .product-top { display: flex; justify-content: space-between; gap: 12px; }
    .product h3 { color: var(--green); font-size: 1.05rem; }
    .price { color: var(--orange); font-weight: 700; white-space: nowrap; }
    .product p { color: var(--muted); font-size: .86rem; margin: 7px 0 15px; }
    .add-button {
      width: 100%;
      padding: 10px;
      border: 1px solid var(--green);
      border-radius: 10px;
      background: white;
      color: var(--green);
      transition: .2s;
    }
    .add-button:hover { color: white; background: var(--green); }

    .about {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 45px;
    }
    .about img { width: 100%; height: 360px; object-fit: cover; border-radius: 22px; }
    .about h2 { color: var(--green); font-size: 2rem; margin: 8px 0 12px; }
    .about p { color: var(--muted); }

    .booking { background: var(--green); color: white; }
    .booking .section-heading h2 { color: white; }
    .booking .section-heading p { color: #d0d8d1; }
    form {
      max-width: 720px;
      margin: auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    form input, form select, form textarea {
      width: 100%;
      padding: 13px 15px;
      border: 1px solid rgba(255,255,255,.25);
      border-radius: 10px;
      outline: none;
      background: rgba(255,255,255,.08);
      color: white;
    }
    form input::placeholder, form textarea::placeholder { color: #d0d8d1; }
    form select option { color: var(--ink); }
    form textarea { grid-column: 1 / -1; min-height: 100px; resize: vertical; }
    form .button { grid-column: 1 / -1; background: var(--orange); }
    form .button:hover { background: #c77845; }

    footer { padding: 27px 0; background: #112d26; color: #d0d8d1; text-align: center; font-size: .85rem; }
    .toast {
      position: fixed;
      bottom: 22px;
      left: 22px;
      z-index: 20;
      padding: 12px 18px;
      border-radius: 12px;
      background: var(--green);
      color: white;
      box-shadow: 0 8px 25px #0002;
      opacity: 0;
      transform: translateY(15px);
      pointer-events: none;
      transition: .25s;
    }
    .toast.show { opacity: 1; transform: translateY(0); }

    @media (max-width: 760px) {
      .nav { flex-wrap: wrap; padding-block: 12px; }
      .nav-links { order: 3; width: 100%; justify-content: center; gap: 18px; }
      .nav-links a { font-size: .8rem; }
      .hero { grid-template-columns: 1fr; padding-top: 40px; }
      .hero-image { min-height: 320px; grid-row: 1; }
      .products { grid-template-columns: repeat(2, 1fr); }
      .about { grid-template-columns: 1fr; }
    }
    @media (max-width: 480px) {
      .products { grid-template-columns: 1fr; }
      form { grid-template-columns: 1fr; }
      form textarea, form .button { grid-column: auto; }
      .hero-image { min-height: 260px; }
    }
  </style>
</head>
<body>
  <header>
    <nav class="nav container" aria-label="القائمة الرئيسية">
      <a class="logo" href="#home">رَ<span>واق</span></a>
      <div class="nav-links">
        <a href="#home">الرئيسية</a>
        <a href="#menu">القائمة</a>
        <a href="#about">قصتنا</a>
        <a href="#booking">احجز طاولة</a>
      </div>
      <button class="cart-button" id="cartButton" type="button">
        سلة الطلبات <span class="cart-count" id="cartCount">0</span>
      </button>
    </nav>
  </header>

  <main>
    <section class="hero container" id="home">
      <div>
        <span class="eyebrow">قهوتك على مهل ☕</span>
        <h1>لحظات هادئة،<br>بنكهة لا تُنسى.</h1>
        <p>في رَواق، نختار حبوبنا بعناية ونحضّر كل فنجان بحب. مكانك المفضّل للقهوة الطازجة واللقاءات الجميلة.</p>
        <a class="button" href="#menu">اكتشف قائمتنا</a>
        <a class="button secondary" href="#booking">احجز مكانك</a>
      </div>
      <div class="hero-image" role="img" aria-label="تحضير فنجان قهوة"></div>
    </section>

    <section class="menu-section" id="menu">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">اختياراتنا المفضّلة</span>
          <h2>قائمة رَواق</h2>
          <p>حضّرناها لك بمكوّنات طازجة ونكهات تستحق التمهّل.</p>
        </div>
        <div class="products" id="products"></div>
      </div>
    </section>

    <section id="about">
      <div class="about container">
        <img src="https://images.unsplash.com/photo-1445116572660-236099ec97a0?auto=format&fit=crop&w=1000&q=85" alt="جلسة دافئة داخل المقهى" loading="lazy">
        <div>
          <span class="eyebrow">حكايتنا</span>
          <h2>مساحة صغيرة للحظات كبيرة</h2>
          <p>بدأت حكاية رَواق من فكرة بسيطة: أن يكون لكل شخص مكان يجد فيه قهوته المفضّلة ووقتًا يستمتع به. نهتم بالتفاصيل، من اختيار الحبوب إلى آخر رشفة.</p>
          <p style="margin-top:12px">نرحّب بك يوميًا، سواء جئت للعمل أو للقاء الأصدقاء أو فقط لتأخذ استراحة تستحقها.</p>
        </div>
      </div>
    </section>

    <section class="booking" id="booking">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">يسعدنا حضورك</span>
          <h2>احجز طاولتك</h2>
          <p>أخبرنا بموعد زيارتك وسنجهّز لك مكانًا مريحًا.</p>
        </div>
        <form id="bookingForm">
          <input name="name" placeholder="الاسم" required>
          <input name="phone" type="tel" placeholder="رقم الهاتف" required>
          <input name="date" type="date" required>
          <select name="guests" required>
            <option value="">عدد الأشخاص</option>
            <option>شخص واحد</option>
            <option>شخصان</option>
            <option>3 أشخاص</option>
            <option>4 أشخاص أو أكثر</option>
          </select>
          <textarea name="notes" placeholder="ملاحظات إضافية (اختياري)"></textarea>
          <button class="button" type="submit">إرسال طلب الحجز</button>
        </form>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">رَواق © <span id="year"></span> — صُنع بحب لمحبي القهوة</div>
  </footer>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    const menuItems = [
      {
        name: "لاتيه رَواق",
        description: "إسبريسو متوازن مع حليب مخملي.",
        price: 18,
        image: "https://images.unsplash.com/photo- latte?auto=format&fit=crop&w=700&q=80"
      },
      {
        name: "كابتشينو",
        description: "قهوة غنية بطبقة رغوة ناعمة.",
        price: 16,
        image: "https://images.unsplash.com/photo-1572442388796-11668a67e53d?auto=format&fit=crop&w=700&q=80"
      },
      {
        name: "قهوة مقطرة",
        description: "حبوب مختارة تُحضّر يدويًا.",
        price: 20,
        image: "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=700&q=80"
      },
      {
        name: "آيس لاتيه",
        description: "إسبريسو وحليب بارد ولمسة انتعاش.",
        price: 19,
        image: "https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=700&q=80"
      },
      {
        name: "تشيز كيك",
        description: "قطعة كريمية تُحضّر كل يوم.",
        price: 22,
        image: "https://images.unsplash.com/photo-1533134242443-d4fd215305ad?auto=format&fit=crop&w=700&q=80"
      },
      {
        name: "كرواسون الزبدة",
        description: "مخبوز طازج بقشرة ذهبية.",
        price: 14,
        image: "https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=700&q=80"
      }
    ];

    const products = document.getElementById("products");
    const cartCount = document.getElementById("cartCount");
    const toast = document.getElementById("toast");
    let cart = 0;
    let toastTimer;

    menuItems.forEach((item, index) => {
      products.insertAdjacentHTML("beforeend", `
        <article class="product">
          <img src="${item.image}" alt="${item.name}" loading="lazy">
          <div class="product-content">
            <div class="product-top">
              <h3>${item.name}</h3>
              <span class="price">${item.price} ر.س</span>
            </div>
            <p>${item.description}</p>
            <button class="add-button" data-index="${index}" type="button">أضف إلى السلة</button>
          </div>
        </article>
      `);
    });

    function showToast(message) {
      toast.textContent = message;
      toast.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove("show"), 2600);
    }

    products.addEventListener("click", event => {
      const button = event.target.closest(".add-button");
      if (!button) return;
      cart++;
      cartCount.textContent = cart;
      showToast(`أُضيف ${menuItems[button.dataset.index].name} إلى السلة`);
    });

    document.getElementById("cartButton").addEventListener("click", () => {
      showToast(cart ? `عدد المنتجات في سلتك: ${cart}` : "سلتك فارغة حاليًا");
    });

    document.getElementById("bookingForm").addEventListener("submit", event => {
      event.preventDefault();
      const name = new FormData(event.currentTarget).get("name");
      showToast(`شكرًا ${name}، استلمنا طلب الحجز!`);
      event.currentTarget.reset();
    });

    document.getElementById("year").textContent = new Date().getFullYear();
    document.querySelector('[name="date"]').min = new Date().toISOString().split("T")[0];
  </script>
</body>
</html>